# 服务端端口
PORT=8787
HOST=127.0.0.1

# 公开部署配置页时必须设置；留空时仅允许本机访问配置接口
ADMIN_PASSWORD=

# 可选：直接通过环境变量提供 AI 配置，优先级高于配置页保存值
AI_PROVIDER_NAME=OpenAI 兼容服务
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_TEMPERATURE=0.2
AI_TIMEOUT_MS=60000

# 可选：指定配置加密主密钥。未设置时会在 .data/ 中生成本机密钥
CONFIG_ENCRYPTION_KEY=
