PORT=3000
NODE_ENV=development

# 生产环境必须设置，用于保护 /config 和配置接口。
ADMIN_PASSWORD=

# 可选：通过环境变量提供初始 AI 配置，也可以在 /config 页面保存。
AI_PROTOCOL=responses
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5.6
AI_API_KEY=
AI_TIMEOUT_MS=120000

# 可选：固定配置加密主密钥；未设置时会在 .data/ 下生成本机密钥。
CONFIG_ENCRYPTION_KEY=

# 仅在明确使用可信反向代理时设置。
TRUST_PROXY=
