# 后端环境变量配置
# 复制此文件为 .env 并填入实际值

# AI API 配置
AI_API_URL=https://api.linapi.net/v1/chat/completions
AI_API_KEY=your-api-key-here
AI_MODEL=gemini-3.1-pro-preview

# 服务端口
PORT=3001

# 安全配置（按需修改）
# 允许跨域来源，多个用英文逗号分隔；留空表示仅同源/本地
CORS_ORIGINS=

# Cookie 安全位（生产环境建议 true，并使用 HTTPS）
COOKIE_SECURE=false

# 会话与令牌时长（毫秒）
SECURITY_SESSION_TTL_MS=7200000
SECURITY_TOKEN_TTL_MS=90000
SECURITY_TOKEN_MAX_USES=8
