# 后端环境变量配置
# 复制此文件为 .env 并填入实际值

# AI API 配置
AI_API_URL=https://api.linapi.net/v1/chat/completions
AI_API_KEY=your-api-key-here
# 多Key轮换（可选）：支持逗号或换行分隔。配置后会自动轮换与故障切换
# AI_API_KEYS=key1,key2,key3
AI_MODEL=gemini-3-flash-preview
# AI_KEY_COOLDOWN_MS=120000
# AI_KEY_FAILURE_THRESHOLD=2

# 服务端口
PORT=3001

# 安全配置（按需修改）
# 允许跨域来源，多个用英文逗号分隔；留空表示仅同源/本地
CORS_ORIGINS=

# Cookie 安全位（生产环境建议 true，并使用 HTTPS）
COOKIE_SECURE=false

# 会话与令牌时长（毫秒）
SECURITY_SESSION_TTL_MS=7200000
SECURITY_TOKEN_TTL_MS=90000
SECURITY_TOKEN_MAX_USES=8
# 续题签名密钥；生产环境必须单独配置，至少 16 字符。未配置时使用 SESSION_SECRET 或首个 AI 密钥。
# CONTINUATION_GRANT_SECRET=replace-with-a-long-random-secret
