# 管理员账号必须由部署环境显式提供，项目不会提供默认口令。
ADMIN_USERNAME=
ADMIN_PASSWORD=

# 可选：服务监听端口、加密配置文件位置和上游请求超时（毫秒）。
PORT=8791
AI_SETTINGS_FILE=.ai-config.local.json
UPSTREAM_TIMEOUT_MS=180000
RECOGNITION_OPERATION_TIMEOUT_MS=600000
RECOVERY_TARGET_TIMEOUT_MS=20000
RECOVERY_BATCH_TIMEOUT_MS=12000
# DOCX 原文件页数核验的最大请求体字节数，默认 512MiB；大资料可按服务器内存调整。
DOCX_IMPORT_MAX_BYTES=536870912
# 生产默认关闭耗时复检；需要开启时显式设为 1，主识别结果不会受影响。
WORD_RECOGNITION_RECOVERY=0

# 可选：仅在服务位于受信任的反向代理之后时设为 1，使限流按代理转发的客户端 IP 识别。
# 默认不信任 X-Forwarded-For，直接部署或无法确认代理链路时请保持 0。
TRUST_PROXY=0
