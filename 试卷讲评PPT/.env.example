PORT=5270
HOST=127.0.0.1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.linapi.net/v1
OPENAI_MODEL=gemini-3-flash-preview

# 可选：请求体解析上限（Express）
REQUEST_BODY_LIMIT=80mb

# 可选：单次AI请求安全阈值（字节）
MAX_CHAT_REQUEST_BYTES=8388608

# 可选：上游 AI 超时时间（毫秒）
AI_REQUEST_TIMEOUT_MS=180000

# 可选：默认最大输出 Token 与 Temperature
AI_MAX_TOKENS=8192
AI_TEMPERATURE=0.2
